# ============================================================
# Turso (cloud SQLite) bağlantısı
# - Yerel geliştirme: bu değerleri boş bırakırsanız uygulama
#   `file:local.db` dosyasını kullanır (token gerekmez).
# - Vercel/prodüksiyon: Turso Dashboard'dan aldığınız değerleri
#   Vercel > Settings > Environment Variables'a ekleyin.
# ============================================================
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Admin paneli giriş şifresi (server action ile doğrulanır)
ADMIN_PASSWORD=change-me
